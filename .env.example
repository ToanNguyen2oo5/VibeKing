# Gemini API Key - lấy từ https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_api_key_here

# Demo mode: true = dùng ảnh cache sẵn, false = gọi API thật
VITE_DEMO_MODE=true

# Hugging Face Token (tùy chọn, để tăng GPU quota khi ghép mặt): https://huggingface.co/settings/tokens
VITE_HF_TOKEN=your_hf_token_here
